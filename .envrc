# JKRouter devshell — direnv
# Load with: direnv allow

# Source project .env if present
if [ -f ".env" ]; then
  export $(cat .env | grep -v '^#' | xargs)
fi

export PATH="$(pwd)/web/node_modules/.bin:$PATH"
export PATH="$(pwd)/jkserver/cmd:$PATH"

# Go
export GOPATH="$HOME/.go"
export GOROOT="/nix/store/i77g9dmcd399rmxk8688qfr4g2wzgk37-go-1.26.7"
export PATH="$GOROOT/bin:$GOPATH/bin:$PATH"
export GOFLAGS="-mod=readonly"

# Node / pnpm / Nuxt
export NODE_ENV="${NODE_ENV:-development}"
export NUXI_TELEMETRY_DISABLED=1

# JKRouter
export PORT="${PORT:-20127}"
export DATA_DIR="${DATA_DIR:-$HOME/.jkrouter}"